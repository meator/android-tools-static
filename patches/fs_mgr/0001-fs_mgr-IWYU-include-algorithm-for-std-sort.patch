From 1a408600a484d7f1ad9014d34acc2077cee32f36 Mon Sep 17 00:00:00 2001
From: Christopher Fore <csfore@posteo.net>
Date: Mon, 20 Nov 2023 15:19:12 -0500
Subject: [PATCH] fs_mgr: IWYU include <algorithm> for std::sort

GCC 14 starts to no longer include <algorithm> by default, resulting in
it needing to be explicitly declared.

Test: Recompiled with GCC 14 and succeeded

Change-Id: Ifc5dd58b7476ba728ae604cd2924cb68fbcab701
Signed-off-by: Christopher Fore <csfore@posteo.net>
---
 liblp/include/liblp/liblp.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/liblp/include/liblp/liblp.h b/liblp/include/liblp/liblp.h
index 5f84b199..519c7b7b 100644
--- a/liblp/include/liblp/liblp.h
+++ b/liblp/include/liblp/liblp.h
@@ -20,6 +20,7 @@
 #include <stddef.h>
 #include <stdint.h>
 
+#include <algorithm>
 #include <map>
 #include <memory>
 #include <string>
-- 
2.54.0

