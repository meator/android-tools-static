From 7dd5eeb1709a74f9027a37cb1937f0a8f392e4f1 Mon Sep 17 00:00:00 2001
From: meator <meator.dev@gmail.com>
Date: Fri, 10 Jul 2026 22:25:31 +0200
Subject: [PATCH] noinstall

Do not install include files and library itself when it's an
internal static library.
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 74b7f59a5..0e43365e1 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,7 +40,7 @@ enable_language(CXX)
 include(CTest)
 include(GNUInstallDirs)
 
-set(INSTALL_ENABLED 1)
+set(INSTALL_ENABLED 0)
 
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING AND
    BUILD_TESTING)
-- 
2.54.0

