From 8bf67fa06e49956115d5991f0ea848e2dfca10a5 Mon Sep 17 00:00:00 2001
From: meator <meator.dev@gmail.com>
Date: Tue, 7 Jul 2026 22:52:46 +0200
Subject: [PATCH] noinstall

Do not install include files and library itself when it's an
internal static library.
---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 51e0b4cf7..087786ef8 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -41,7 +41,7 @@ enable_language(CXX)
 include(CTest)
 include(GNUInstallDirs)
 
-set(INSTALL_ENABLED 1)
+set(INSTALL_ENABLED 0)
 
 if(CMAKE_VERSION VERSION_LESS 3.21 AND
    CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
-- 
2.54.0

