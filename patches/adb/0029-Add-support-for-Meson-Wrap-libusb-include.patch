From 0c14ccf72b1a4ee0031c62bd008cd31117dd26b4 Mon Sep 17 00:00:00 2001
From: meator <meator.dev@gmail.com>
Date: Tue, 7 Jul 2026 20:16:03 +0200
Subject: [PATCH] Add support for Meson Wrap libusb include

This is a modification of
0005-Include-libusb-1.0-libusb.h-instead-of-libusb-libusb.patch made by
android-tools-static.
---
 client/usb_libusb_device.cpp          | 5 ++++-
 client/usb_libusb_device.h            | 5 ++++-
 client/usb_libusb_hotplug.cpp         | 5 ++++-
 client/usb_libusb_hotplug.h           | 5 ++++-
 client/usb_libusb_inhouse_hotplug.cpp | 5 ++++-
 5 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/client/usb_libusb_device.cpp b/client/usb_libusb_device.cpp
index f75178e2..c72da6c8 100644
--- a/client/usb_libusb_device.cpp
+++ b/client/usb_libusb_device.cpp
@@ -31,7 +31,10 @@
 #ifdef ANDROID_TOOLS_USE_BUNDLED_LIBUSB
 #include <libusb/libusb.h>
 #else
-#include <libusb-1.0/libusb.h>
+// nmeum/android-tools includes libusb-1.0/libusb.h instead. I don't know why.
+// libusb's pkg-config file adds libusb-1.0 to include directories, so let's
+// include the header directly
+#include <libusb.h>
 #endif
 
 #include <android-base/file.h>
diff --git a/client/usb_libusb_device.h b/client/usb_libusb_device.h
index 3e4316fe..435551b1 100644
--- a/client/usb_libusb_device.h
+++ b/client/usb_libusb_device.h
@@ -27,7 +27,10 @@
 #ifdef ANDROID_TOOLS_USE_BUNDLED_LIBUSB
 #include "libusb/libusb.h"
 #else
-#include <libusb-1.0/libusb.h>
+// nmeum/android-tools includes libusb-1.0/libusb.h instead. I don't know why.
+// libusb's pkg-config file adds libusb-1.0 to include directories, so let's
+// include the header directly
+#include <libusb.h>
 #endif
 
 // A session is started when a device is connected to a workstation. It ends upon its
